<header class="flex justify-between align-center p-8 flex-wrap min-h-30 gap-4 bg-black text-white w-full shrink-0">

    <div class="w-auto h-20">
         <%= image_tag "icon_anjos.png", alt: "logo",class:"h-full w-auto object-contain"%>
    </div>

    <nav class="flex flex-wrap gap-4 align-center justify-center">
        <a class="ml-8 font-bold hover:text-orange-500 hover:underline" href="/">Inicial</a>
    </nav>
    <div class="flex gap-3">
        <%= button_to "Entrar", "/user/login", method: :get, form_class: "inline", class: "px-6 py-2 border bg-orange-500 rounded-full cursor-pointer transition-all duration-300 hover:border-orange-400" %>
        <%= button_to "Carrinho", "/carrinho/index", method: :get, form_class: "inline", class: "px-6 py-2 border bg-orange-500 rounded-full cursor-pointer transition-all duration-300 hover:border-orange-400" %>
    </div>
</header>

<main>
    <h1><%= @user.nome%></h1>
    <h1><%= @user.email%> </h1>
</main>
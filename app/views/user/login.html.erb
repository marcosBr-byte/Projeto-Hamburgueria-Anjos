<header class="flex justify-between items-center p-8 flex-wrap min-h-30 gap-4 bg-[#0B0A09] text-white w-full shrink-0">

    <div class="flex flex-wrap gap-4 align-center justify-center">
        <%= link_to 'Inicio', "/" ,class: "ml-8  border border-[#0B0A09] font-bold hover:text-[#FF6B00]  hover:bg-[##FF6B00]" %>
    </div>

    <div class="w-auto h-20">
        <%= image_tag "icon_anjos.png", alt: "logo", class: "h-full w-auto object-contain" %>
    </div>

    <div class="flex gap-3">
        <%= button_to "Carrinho", "/carrinho/index", method: :get, form_class: "inline", class: "px-6 py-2 border bg-[#0B0A09] rounded-full cursor-pointer transition-all duration-300 hover:border-[#FF6B00] hover:bg-[#FF6B00] hover:text-white" %>
    </div>
</header>

<main class="flex flex-col items-center justify-center min-h-screen gap-6 text-white bg-[#0B0A09]">


    <div class="w-full max-w-md p-8 bg-[#0D0D0D]/70 border border-[#FF6B00] rounded-xl shadow-md">

        <h1 class="text-3xl font-bold text-center mb-6">Login</h1>

        <%= form_with model: @user, url: "/user/login", method: :post do |form| %>

            
            <div class="flex flex-col gap-2 mb-4">
                <%= form.label :email, "Email", class: "font-medium" %>
                <%= form.email_field :email, class: "w-full p-3 border border-[#FF6B00] rounded-xl" %>
            </div>

            <div class="flex flex-col gap-2 mb-6">
                <%= form.label :password, "Senha", class: "font-medium" %>
                <%= form.password_field :password, class: "w-full p-3 border border-[#FF6B00] rounded-xl" %>
            </div>

            <div class="flex flex-col gap-4">
                <%= form.submit "Entrar", class: "w-full bg-[#FF6B00] text-white p-3 rounded-xl cursor-pointer hover:bg-[#FF8C00] transition-all duration-300" %>
                <%= link_to "Não tem uma conta? Cadastrar-se", "/user/cadastrar", class: "text-center text-white hover:underline" %>
            </div>
            

        <% end %>

    </div>
</main>